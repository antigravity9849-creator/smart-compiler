{
  "name": "smart-compiler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,UI\" -c \"blue,green\" \"npm run server\" \"vite\"",
    "server": "cd server && node --watch index.js",
    "server:install": "cd server && npm install",
    "setup": "npm install && npm run server:install",
    "build": "vite build",
    "build:all": "npm install && vite build && cd server && npm install",
    "start": "node server/index.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:mobile": "node test-mobile-editor.mjs",
    "test:e2e": "node test-e2e.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.33.0",
    "mammoth": "^1.12.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "vite": "^8.0.12"
  }
}
